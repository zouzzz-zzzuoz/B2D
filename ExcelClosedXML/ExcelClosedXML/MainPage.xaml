<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExcelClosedXML.MainPage"
             Title="B2D"
             Shell.NavBarIsVisible="False">

    <Grid>

        <!-- Contenu centré -->
        <VerticalStackLayout Padding="30,20,30,40"
                             Spacing="16"
                             VerticalOptions="Center">

            <Image Source="ico.png"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Scale="0.5" />

            <Label Text="B2D"
                   HorizontalOptions="Center"
                   FontSize="34"
                   TextColor="{StaticResource Primary}" />

            <Button
                x:Name="OpenBtn"
                Text="Ouvrir un Bon de Débit"
                Clicked="OnOpenFileClicked"
                HorizontalOptions="Fill" />

            <Label
                x:Name="StatusLabel"
                HorizontalOptions="Center"
                IsVisible="False"
                TextColor="{StaticResource Primary}" />

        </VerticalStackLayout>

        <!-- Texte en bas à droite -->
        <Label Text="créé par Romu"
               FontSize="10"
               TextColor="{StaticResource Primary}"
               HorizontalOptions="End"
               VerticalOptions="End"
               Margin="0,0,10,10" />

    </Grid>

</ContentPage>
