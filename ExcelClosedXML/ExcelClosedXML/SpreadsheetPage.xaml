<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExcelClosedXML.SpreadsheetPage"
             Title="Feuille de calcul"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Barre de statut -->
        <Label x:Name="StatusLabel"
               Grid.Row="1"
               Padding="8,4"
               BackgroundColor="#FFF9C4"
               TextColor="#555"
               FontSize="12"
               IsVisible="False" />

        <!-- Zone figée : en-têtes de colonnes + lignes 1 à 7 -->
        <Grid x:Name="FrozenGrid"
              Grid.Row="2"
              HorizontalOptions="Fill" />

        <!-- Zone scrollable : lignes 8 et suivantes -->
        <ScrollView Grid.Row="3"
                    Orientation="Vertical"
                    x:Name="SpreadsheetScroll">
            <Grid x:Name="SpreadsheetGrid" HorizontalOptions="Fill" />
        </ScrollView>

    </Grid>

</ContentPage>
