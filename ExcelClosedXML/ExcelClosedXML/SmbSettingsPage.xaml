<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExcelClosedXML.SmbSettingsPage"
             Title="SMB"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#202020}">
    <Grid RowDefinitions="*,Auto" Padding="20" RowSpacing="20">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16">
                <!-- Hôte -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Hôte" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#666, Dark=#CCC}" />
                    <Entry x:Name="ServerEntry" 
                           Placeholder="192.168.1.14/Users/moumo/Desktop/DEBIT/fichiers" 
                           Keyboard="Url"
                           BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333}" />
                </VerticalStackLayout>

                <!-- Nom d'utilisateur -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Nom d'utilisateur" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#666, Dark=#CCC}" />
                    <Entry x:Name="UserNameEntry" 
                           Placeholder="Asl"
                           BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333}" />
                </VerticalStackLayout>

                <!-- Mot de passe -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Mot de passe" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#666, Dark=#CCC}" />
                    <Entry x:Name="PasswordEntry" 
                           IsPassword="True"
                           BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333}" />
                </VerticalStackLayout>

                <!-- Anonyme -->
                <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                    <CheckBox x:Name="AnonymousCheckBox" VerticalOptions="Center" />
                    <Label Text="Anonyme" FontSize="14" VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <!-- Résultat du test de connexion (vert / rouge) -->
                <Label x:Name="StatusLabel"
                       Text=""
                       IsVisible="False"
                       FontAttributes="Bold"
                       Margin="0,8,0,0" />

                <!-- Débit lecture / écriture, sous le texte de connexion -->
                <Label x:Name="SpeedLabel"
                       Text=""
                       IsVisible="False"
                       FontSize="15"
                       Margin="0,-8,0,0"
                       TextColor="{AppThemeBinding Light=#1565C0, Dark=#64B5F6}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Boutons -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Button Grid.Column="0" Text="Tester" Clicked="OnTestClicked" />
            <Button Grid.Column="1" Text="Annuler" Clicked="OnCancelClicked" />
            <Button Grid.Column="2" Text="Sauver" Clicked="OnOkClicked" />
        </Grid>
    </Grid>
</ContentPage>
